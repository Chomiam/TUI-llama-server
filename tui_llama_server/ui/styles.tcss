/* Sober, Dark, Premium Product Palette */

Screen {
    background: #0d0f14;
    color: #cbd5e1;
    layout: vertical;
}

#header-container {
    height: 3;
    dock: top;
    background: #141721;
    border-bottom: solid #222738;
    layout: horizontal;
    padding: 0 1;
    align: left middle;
}

#app-title {
    width: 22;
    text-style: bold;
    color: #38bdf8;
    content-align: left middle;
}

#hardware-badge {
    width: auto;
    background: #1e2436;
    color: #94a3b8;
    padding: 0 1;
    border-left: solid #334155;
    border-right: solid #334155;
    margin-right: 1;
    text-align: center;
}

#server-status-badge {
    width: auto;
    padding: 0 1;
    margin-right: 1;
    text-style: bold;
}

.status-stopped {
    background: #27272a;
    color: #a1a1aa;
}

.status-running {
    background: #064e3b;
    color: #34d399;
}

.status-error {
    background: #450a0a;
    color: #f87171;
}

#base-url-badge {
    width: auto;
    color: #38bdf8;
    background: #0c4a6e;
    padding: 0 1;
    text-style: bold;
}

#btn-copy-url {
    margin-left: 1;
    height: 1;
    min-width: 11;
    background: #1e293b;
    color: #94a3b8;
    border: none;
}

#btn-copy-url:hover {
    background: #334155;
    color: #f8fafc;
}

#main-tabs {
    height: 1fr;
}

TabbedContent {
    background: #0d0f14;
}

TabPane {
    padding: 1;
}

/* Models View */
#models-container {
    layout: horizontal;
    height: 1fr;
}

#models-list-panel {
    width: 50%;
    height: 1fr;
    border: round #222738;
    background: #12151f;
    padding: 0 1;
}

#models-detail-panel {
    width: 50%;
    height: 1fr;
    border: round #222738;
    background: #12151f;
    padding: 1;
    margin-left: 1;
}

.panel-header {
    text-style: bold;
    color: #e2e8f0;
    border-bottom: solid #222738;
    padding-bottom: 1;
    margin-bottom: 1;
}

DataTable {
    background: transparent;
    border: none;
}

DataTable > .datatable--cursor {
    background: #1e293b;
    color: #38bdf8;
    text-style: bold;
}

/* Detail Card */
.detail-row {
    layout: horizontal;
    height: 1;
    margin-bottom: 1;
}

.detail-label {
    width: 18;
    color: #64748b;
    text-style: bold;
}

.detail-value {
    width: 1fr;
    color: #f1f5f9;
}

.badge-tag {
    background: #1e293b;
    color: #38bdf8;
    padding: 0 1;
}

.badge-tool-yes {
    background: #064e3b;
    color: #34d399;
    padding: 0 1;
}

.badge-tool-no {
    background: #27272a;
    color: #71717a;
    padding: 0 1;
}

/* Monitor View */
#monitor-grid {
    layout: grid;
    grid-size: 2 1;
    grid-columns: 1fr 1fr;
    height: 1fr;
    grid-gutter: 1;
}

.metric-card {
    background: #12151f;
    border: round #222738;
    padding: 1;
    height: 1fr;
}

.meter-row {
    margin-bottom: 1;
}

.meter-label-row {
    layout: horizontal;
    height: 1;
}

.meter-name {
    width: 16;
    text-style: bold;
    color: #94a3b8;
}

.meter-value {
    width: 1fr;
    text-align: right;
    color: #e2e8f0;
}

ProgressBar {
    height: 1;
    margin-top: 0;
    margin-bottom: 1;
}

ProgressBar > .bar--bar {
    color: #38bdf8;
    background: #1e293b;
}

ProgressBar > .bar--complete {
    color: #34d399;
}

/* Logs View */
#logs-container {
    height: 1fr;
    background: #12151f;
    border: round #222738;
    padding: 0;
}

#logs-toolbar {
    height: 3;
    background: #141721;
    border-bottom: solid #222738;
    layout: horizontal;
    padding: 0 1;
    align: left middle;
}

#log-filter-input {
    width: 40;
    background: #0d0f14;
    border: solid #334155;
}

.tool-button {
    height: 1;
    margin-left: 1;
    background: #1e293b;
    color: #cbd5e1;
    border: none;
}

.tool-button:hover {
    background: #334155;
    color: #ffffff;
}

#log-view {
    height: 1fr;
    padding: 0 1;
    background: #0d0f14;
}

/* Server Controls Bar */
#server-controls-bar {
    height: 3;
    dock: bottom;
    background: #141721;
    border-top: solid #222738;
    layout: horizontal;
    padding: 0 1;
    align: center middle;
}

.btn-primary {
    background: #0284c7;
    color: #ffffff;
    border: none;
    min-width: 16;
    margin-right: 1;
    text-style: bold;
}

.btn-primary:hover {
    background: #0ea5e9;
}

.btn-stop {
    background: #991b1b;
    color: #ffffff;
    border: none;
    min-width: 16;
    margin-right: 1;
    text-style: bold;
}

.btn-stop:hover {
    background: #b91c1c;
}

/* Agent Info Card */
#agent-endpoints-box {
    background: #0d0f14;
    border: solid #222738;
    padding: 1;
    margin-top: 1;
}

.endpoint-line {
    color: #38bdf8;
    text-style: bold;
}

.agent-desc {
    color: #64748b;
    margin-top: 1;
}
